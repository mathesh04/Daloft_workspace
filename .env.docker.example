# ════════════════════════════════════════════════════════════
#  D-HRM — Docker / LAN Environment Overrides
#
#  Copy this file to .env.docker and fill in YOUR machine's
#  local IP address (run `ipconfig` → Wi-Fi IPv4 address).
#
#  This file OVERRIDES matching keys from .env at runtime.
#  It only contains the vars that need to change for Docker/LAN.
# ════════════════════════════════════════════════════════════

# ── Replace 192.168.X.X with YOUR Wi-Fi IPv4 address ────────
# Example: APP_FRONTEND_URL=http://192.168.1.25

APP_FRONTEND_URL=http://192.168.X.X
FRONTEND_RESET_PASSWORD_URL=http://192.168.X.X/reset-password

# ── CORS: allow requests from localhost AND the full LAN subnet ──
# The wildcard pattern 192.168.*.* covers all devices on your subnet.
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://192.168.*.*
