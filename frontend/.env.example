# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# D-HRM Frontend — Environment Variable Template
# Copy this file to .env and fill in your real values.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Spring Boot backend API base URL.
# • Local dev: leave as /api — the Vite proxy handles it.
# • Production: set to your full backend URL, e.g. https://api.yourapp.com/api
VITE_API_BASE_URL=/api

# Backend origin for the Vite dev-server reverse proxy (local dev only).
# Change this if your backend runs on a different port.
VITE_BACKEND_ORIGIN=http://127.0.0.1:8080

# App display name shown in the browser tab and UI (optional)
VITE_APP_NAME=Daloft People
